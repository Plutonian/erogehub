<UserControl x:Class="ErogeHub.Wpf.Controls.CharEditModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:ErogeHub.Wpf.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    </UserControl.Resources>

    <!-- DataContext 继承自父级（GameDetailViewModel） -->
    <Border Background="#80000000"
            Visibility="{Binding IsCharEditVisible, Converter={StaticResource Bool2Vis}}">
        <Border Background="#2A2A3C" CornerRadius="8" Padding="24" Width="500"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Edit Character" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,12"/>

                <!-- 角色头像 -->
                <Image Source="{Binding SelectedCharacter.AvatarUrl}" Height="200" Stretch="UniformToFill"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- 角色名 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedCharacter.CharTitle}" FontWeight="Bold" Foreground="#E0E0E0" FontSize="16"/>
                    <TextBlock Text="{Binding SelectedCharacter.CharSubTitle}" Foreground="#999" FontSize="13"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CV 编辑 -->
                <StackPanel>
                    <TextBlock Text="CV:" Foreground="#999" Margin="0,0,0,4"/>
                    <hc:TextBox Text="{Binding SelectedCharacter.Cv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Padding="6,4" FontSize="14" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- 按钮组 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Command="{Binding CloseCharEditCommand}"/>
                    <Button Content="Update" Padding="16,6" Margin="0,0,8,0"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding UpdateCharCVFromModalCommand}"/>
                    <Button Content="SetMan" Padding="16,6"
                            Style="{StaticResource ButtonDanger}"
                            Command="{Binding SetCharManCommand}"
                            CommandParameter="{Binding SelectedCharacter}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
