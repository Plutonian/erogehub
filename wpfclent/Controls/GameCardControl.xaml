<UserControl x:Class="ErogeHub.Wpf.Controls.GameCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:ErogeHub.Wpf.Converters">

    <!-- Converter 使用全局注册（App.xaml → Converters.xaml），无需在此重复定义 -->

    <!-- DataContext 自动继承自父级（Game 对象），所以直接用 {Binding PropertyName} -->
    <!-- 命令通过 RelativeSource 绑定到 UserControl 自身的 DependencyProperty -->

    <!-- 卡片外层：固定宽度，边框颜色根据情感值(Emotion)动态变色 -->
    <Border Width="282" Margin="4" Background="#2A2A3C" CornerRadius="6" BorderThickness="0">
        <StackPanel>
            <!-- 封面图区域：固定宽度 280px，高度按图片比例自动缩放 -->
            <Grid Width="280" Height="400" Background="#1A1A2E">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                                                 From="20" To="0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                                                 From="0" To="20" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Image Width="280"  Cursor="Hand" VerticalAlignment="Top"
                       Source="{Binding CoverUrl}">
                    <Image.InputBindings>
                        <MouseBinding Command="{Binding OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      MouseAction="LeftClick"/>
                    </Image.InputBindings>
                </Image>

                <!-- HATE(-99) 暗化遮罩：替代像素级灰度，避免手动 BitmapFrame 在虚拟化回收时崩溃 -->
                <Border Background="#80000000" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Emotion}" Value="HATE">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- 右上角的"心"情感按钮 -->
                <Button Command="{Binding CycleCardEmotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Width="40" Height="40"
                        Padding="0" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        Background="#AA1E1E2E" Cursor="Hand"
                        Visibility="{Binding ShowEmotion, Converter={StaticResource Bool2Vis}}"
                        ToolTip="Emotion (click to cycle)">
                    <TextBlock Text="♥" FontSize="22" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Emotion}" Value="HATE">
                                        <Setter Property="Foreground" Value="#000000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Emotion}" Value="HOPE">
                                        <Setter Property="Foreground" Value="#FF69B4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Emotion}" Value="LIKE">
                                        <Setter Property="Foreground" Value="#FF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- 鼠标悬停时滑入的暗色半透明覆盖面板 -->
                <Border x:Name="HoverOverlay"
                        VerticalAlignment="Bottom" Background="#E51A1A2E" Padding="6,4"
                        Opacity="0" RenderTransformOrigin="0,1">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <!-- 标题行：PlayState 状态圆圈 + 游戏主标题 + 删除按钮 -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding CycleCardPlayStateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    ToolTip="PlayState (click to cycle)">
                                <Ellipse Width="20" Height="20"
                                         Fill="{Binding PlayState, Converter={StaticResource PlayStateBrush}}"/>
                            </Button>
                            <TextBlock Text="{Binding MainTitle}" FontWeight="Bold"
                                       Foreground="#E0E0E0" FontSize="24"
                                       TextTrimming="CharacterEllipsis" Margin="4,0,0,0" MaxWidth="250" TextWrapping="Wrap"/>
                            <Button Content="[Del]" Foreground="#FF4444" FontSize="10" Margin="4,0,0,0"
                                    Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Style="{StaticResource ButtonDanger}"
                                    Visibility="{Binding IsSame, Converter={StaticResource Bool2Vis}}"
                                    Command="{Binding DeleteCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>

                        <!-- 副标题 -->
                        <TextBlock Text="{Binding SubTitle}" Foreground="#999" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 品牌名称（可点击搜索） + 官网链接 -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding Brand.Name, Converter={StaticResource Str2Vis}}">
                            <Button Command="{Binding BrandClickToSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Brand.Name}"
                                    Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
                                <TextBlock Text="{Binding Brand.Name}" Foreground="#7AB8FF" FontSize="12"/>
                            </Button>
                            <TextBlock Margin="4,0,0,0" FontSize="12"
                                       Visibility="{Binding Brand.Website, Converter={StaticResource Web2Vis}}">
                                <Hyperlink NavigateUri="{Binding Brand.Website}"
                                           RequestNavigate="OpenHyperlink_RequestNavigate">
                                    <Run Text="(公式サイト)" Foreground="#7AB8FF"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- 星级评分 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <hc:Rate Value="{Binding Star, Mode=TwoWay}" AllowClear="True"
                                     FontSize="14" Foreground="#FFB800"
                                     Visibility="{Binding ShowStar, Converter={StaticResource Bool2Vis}}"
                                     ValueChanged="CardRate_ValueChanged"/>
                        </StackPanel>

                        <!-- 标签列表 -->
                        <ItemsControl ItemsSource="{Binding Tag}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="12" Margin="0,0,4,3"
                                            Padding="5,2" Background="#FFABD3" Foreground="#333"
                                            BorderThickness="0" Cursor="Hand"
                                            Command="{Binding TagClickToSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部：发布日期（左） + 存储位置（右） -->
            <DockPanel Margin="6,4,6,0">
                <Button DockPanel.Dock="Right"
                        Command="{Binding ToggleCardLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Visibility="{Binding Published, Converter={StaticResource Bool2Vis}}"
                        ToolTip="Location (click to toggle)" Margin="8,0,0,0">
                    <TextBlock FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✓"/>
                                <Setter Property="Foreground" Value="#44AA44"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Location}" Value="REMOTE">
                                        <Setter Property="Text" Value="☁"/>
                                        <Setter Property="Foreground" Value="#88AACC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <TextBlock Text="{Binding PublishDate, Converter={StaticResource DateRel}}"
                           Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
