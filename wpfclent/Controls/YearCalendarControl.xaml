<!--
    YearCalendarControl - 单年日历控件（参照 WEB month-calendar）
    显示一个年份标题 + 4×3 月份网格，有数据的月份蓝底高亮，无数据的月份灰底。
-->
<UserControl x:Class="ErogeHub.Wpf.Controls.YearCalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ErogeHub.Wpf.Models">

    <StackPanel Margin="0,4">
        <!-- 年份标题栏：年份名称 + 总数徽章 -->
        <DockPanel Margin="0,0,0,5">
            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="7,1">
                <TextBlock Text="{Binding Year.Count, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#CCC" FontSize="10"/>
            </Border>
            <TextBlock Text="{Binding Year.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#DDD" FontWeight="SemiBold" FontSize="13"/>
        </DockPanel>

        <!-- 4×3 月份网格：固定 12 格，1~12月 -->
        <ItemsControl ItemsSource="{Binding Months, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DateGroupItem}">
                    <!-- 注意：Background / Padding 不在 Border 标签上写死，全部交给 Style 控制，
                         否则直接属性值会覆盖 Style Setter 的优先级 -->
                    <Border Margin="1" CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Count}" Value="0">
                                                <Setter Property="Foreground" Value="#444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Count, StringFormat='({0})'}"
                                       FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFCC00"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- 默认 = 有数据状态 -->
                                <Setter Property="Background" Value="#5577BB"/>
                                <Setter Property="Padding"     Value="10,8"/>
                                <Style.Triggers>
                                    <!-- 空白月份 → 浅灰底、稍大内边距（无数据时文字更居中） -->
                                    <DataTrigger Binding="{Binding Count}" Value="0">
                                        <Setter Property="Background"   Value="#E8EAF0"/>
                                        <Setter Property="Padding"     Value="10,10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

</UserControl>
