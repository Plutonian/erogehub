<!--
    Converters.xaml - 全局值转换器
    在 App.xaml 中合并到全局字典，所有窗口/控件可用
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ErogeHub.Wpf.Converters">

    <!-- 布尔 ↔ 可见性 -->
    <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    <conv:InverseBoolConverter x:Key="InvBool"/>

    <!-- 枚举 ↔ 画刷 -->
    <conv:PlayStateToBrushConverter x:Key="PlayStateBrush"/>
    <conv:EmotionToBrushConverter x:Key="EmotionBrush"/>

    <!-- 搜索类型判断（SearchType → Visibility） -->
    <conv:IsStarInputConverter x:Key="IsStar"/>
    <conv:IsSelectInputConverter x:Key="IsSelect"/>
    <conv:IsTextInputConverter x:Key="IsText"/>

    <!-- 字符串处理 -->
    <conv:StringToVisibilityConverter x:Key="Str2Vis"/>
    <conv:StringDoubleConverter x:Key="Str2Double"/>
    <conv:EmptyToVisibilityConverter x:Key="Empty2Vis"/>

    <!-- 其他 -->
    <conv:WebsiteToVisibilityConverter x:Key="Web2Vis"/>
    <conv:DateRelativeConverter x:Key="DateRel"/>
    <conv:CoverImageConverter x:Key="CoverImg"/>

</ResourceDictionary>
