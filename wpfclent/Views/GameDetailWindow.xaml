<Window x:Class="ErogeHub.Wpf.Views.GameDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:ErogeHub.Wpf.Converters"
        xmlns:vm="clr-namespace:ErogeHub.Wpf.ViewModels"
        xmlns:models="clr-namespace:ErogeHub.Wpf.Models"
        Title="Game Detail" Width="1100" Height="800"
        Background="#1E1E2E" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:PlayStateToBrushConverter x:Key="PlayStateBrush"/>
        <conv:EmotionToBrushConverter x:Key="EmotionBrush"/>
        <conv:StringToVisibilityConverter x:Key="Str2Vis"/>
        <conv:WebsiteToVisibilityConverter x:Key="Web2Vis"/>
        <conv:DateRelativeConverter x:Key="DateRel"/>
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmpty2Vis"/>

        <!-- ========== 角色卡片模板 ========== -->
        <DataTemplate x:Key="CharCardTemplate" DataType="{x:Type models:GameCharacter}">
            <Border Background="#2A2A3C" CornerRadius="6" Margin="4" Width="240">
                <StackPanel>
                    <Image Source="{Binding AvatarUrl}" Height="200" Stretch="UniformToFill"
                           HorizontalAlignment="Center"/>
                    <StackPanel Margin="8,4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#E0E0E0"
                                   TextTrimming="CharacterEllipsis" FontSize="14"/>
                        <!-- CV 编辑区 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding Cv, Converter={StaticResource Str2Vis}}">
                            <TextBlock Text="CV: " Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Cv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="80" FontSize="11" Padding="2,1"/>
                            <Button Content="✓" Padding="6,2" Margin="2,0" FontSize="11"
                                    Command="{Binding DataContext.UpdateCharCVCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                        <!-- CV 搜索链接 -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding Cv, Converter={StaticResource Str2Vis}}">
                            <Button Content="Wiki" FontSize="10" Padding="4,1" Margin="0,0,4,0"
                                    Command="{Binding DataContext.OpenCVWikiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Cv}"/>
                            <Button Content="Bangumi" FontSize="10" Padding="4,1"
                                    Command="{Binding DataContext.OpenCVBangumiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Cv}"/>
                        </StackPanel>
                        <!-- TrueCV -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding TrueCV, Converter={StaticResource Str2Vis}}">
                            <TextBlock Text="TrueCV: " Foreground="#FFABD3" FontSize="11"/>
                            <TextBlock Text="{Binding TrueCV}" Foreground="#E0E0E0" FontSize="11"/>
                        </StackPanel>
                        <!-- Intro -->
                        <TextBox Text="{Binding Intro}" IsReadOnly="True" Margin="0,4,0,0"
                                 FontSize="11" BorderThickness="0" Background="Transparent"
                                 Foreground="#BBB" TextWrapping="Wrap" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <!-- ========== Loading ========== -->
            <hc:LoadingCircle Visibility="{Binding IsLoading, Converter={StaticResource Bool2Vis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40"/>

            <!-- ========== 主内容 ========== -->
            <TabControl Background="Transparent" Margin="8">
                <!-- ========== Tab 0: 基本情報 ========== -->
                <TabItem Header="基本情報" Foreground="#CCC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                        <StackPanel Margin="8">
                            <!-- 标题行 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Command="{Binding CyclePlayStateCommand}"
                                        Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                        ToolTip="PlayState (click to cycle)">
                                    <Ellipse Width="16" Height="16"
                                             Fill="{Binding Game.PlayState, Converter={StaticResource PlayStateBrush}}"/>
                                </Button>
                                <TextBlock Text="{Binding Game.MainTitle}" FontWeight="Bold" Foreground="#E0E0E0"
                                           FontSize="18" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="700"/>
                                <Button Content="⚙" FontSize="16" Padding="4,2" Margin="8,0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Edit Title"
                                        Command="{Binding ShowEditModalCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Game.SubTitle}" Foreground="#999" FontSize="13"
                                       Margin="22,0,0,4" TextWrapping="Wrap"/>

                            <!-- Tags -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <TextBlock Text="Tags: " Foreground="#999" VerticalAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding Game.Tag}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFABD3" CornerRadius="3" Margin="2,0" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" Foreground="#333" FontSize="11"/>
                                                    <Button Content="×" FontSize="11" Margin="4,0,0,0" Padding="2,0"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <TextBox Text="{Binding NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         hc:InfoElement.Placeholder="新标签" Width="120" Padding="4,2" FontSize="11"/>
                                <Button Content="+" Padding="8,2" Margin="4,0"
                                        Command="{Binding AddTagCommand}"/>
                            </StackPanel>

                            <!-- Brand -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <TextBlock Text="Brand: " Foreground="#999" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Game.Brand.Name}" Foreground="#7AB8FF" FontSize="13"/>
                                <TextBlock Margin="6,0,0,0" FontSize="11"
                                           Visibility="{Binding Game.Brand.Website, Converter={StaticResource Web2Vis}}">
                                    <Hyperlink NavigateUri="{Binding Game.Brand.Website}"
                                               RequestNavigate="OpenHyperlink_RequestNavigate">
                                        <Run Text="(公式サイト)" Foreground="#7AB8FF"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <!-- Metadata -->
                            <StackPanel Margin="0,8,0,4">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="発売日: " Foreground="#999" FontSize="12" Width="60"/>
                                    <TextBlock Text="{Binding Game.PublishDate, Converter={StaticResource DateRel}}"
                                               Foreground="#E0E0E0" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"
                                            Visibility="{Binding Game.Painter.Count, Converter={StaticResource NotEmpty2Vis}}">
                                    <TextBlock Text="原画: " Foreground="#999" FontSize="12" Width="60"/>
                                    <ItemsControl ItemsSource="{Binding Game.Painter}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#7AB8FF" FontSize="12" Margin="0,0,8,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"
                                            Visibility="{Binding Game.Writer.Count, Converter={StaticResource NotEmpty2Vis}}">
                                    <TextBlock Text="シナリオ: " Foreground="#999" FontSize="12" Width="60"/>
                                    <ItemsControl ItemsSource="{Binding Game.Writer}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#7AB8FF" FontSize="12" Margin="0,0,8,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- 快速操作 -->
                            <Border Background="#252535" CornerRadius="6" Margin="0,12,0,0" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Emotion: " Foreground="#999" VerticalAlignment="Center"/>
                                    <Button Command="{Binding CycleEmotionCommand}"
                                            Padding="4,2" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Click to cycle" Margin="4,0,8,0">
                                        <TextBlock Text="♥" FontSize="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.Emotion}" Value="-99">
                                                            <Setter Property="Foreground" Value="#8B0000"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Emotion}" Value="1">
                                                            <Setter Property="Foreground" Value="#FF69B4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Emotion}" Value="99">
                                                            <Setter Property="Foreground" Value="#FF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <TextBlock Text="Location: " Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Button Command="{Binding ToggleLocationCommand}"
                                            Padding="4,2" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Click to toggle" Margin="4,0,8,0">
                                        <TextBlock FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="#44AA44"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.Location}" Value="0">
                                                            <Setter Property="Text" Value="☁"/>
                                                            <Setter Property="Foreground" Value="#88AACC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <TextBlock Text="Star: " Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <hc:Rate Value="{Binding Game.Star, Mode=TwoWay}" AllowClear="True"
                                             FontSize="14" Foreground="#FFB800" Margin="4,0,8,0"
                                             ValueChanged="DetailRate_ValueChanged"/>

                                    <TextBlock Text="MarkSame: " Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ToggleButton IsChecked="{Binding Game.IsSame, Mode=TwoWay}" Click="DetailMarkSame_Click"
                                                  Content="同" Padding="8,2" Margin="4,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Tab 1: ストーリー ========== -->
                <TabItem Header="ストーリー" Foreground="#CCC">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Game.StoryImageUrl}" Stretch="Uniform"
                               VerticalAlignment="Top" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Game.Story}" IsReadOnly="True"
                                 FontSize="16" BorderThickness="0" Background="#252535" Foreground="#DDD"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Padding="12"/>
                    </Grid>
                </TabItem>

                <!-- ========== Tab 2: キャラクター ========== -->
                <TabItem Header="キャラクター" Foreground="#CCC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                        <StackPanel Margin="8">
                            <TextBlock Text="ヒロイン" Foreground="#7AB8FF" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Heroines}" ItemTemplate="{StaticResource CharCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="主人公" Foreground="#7AB8FF" FontSize="14" FontWeight="Bold" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding Protagonists}" ItemTemplate="{StaticResource CharCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Tab 3: サンプル画像 ========== -->
                <TabItem Header="サンプル画像" Foreground="#CCC">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4">
                        <ItemsControl ItemsSource="{Binding Game.SimpleImgs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Url}" Stretch="Uniform" Margin="4" MaxHeight="500"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== Tab 4: 外部検索 ========== -->
                <TabItem Header="外部検索" Foreground="#CCC">
                    <StackPanel Margin="16,8">
                        <TextBlock Text="Search" Foreground="#CCC" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Google" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="google"/>
                            <Button Content="Wiki" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="wiki"/>
                            <Button Content="GetChu" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="getchu"/>
                            <Button Content="DLsite" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="dlsite"/>
                            <Button Content="ErogameScape" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="erogamescape"/>
                            <Button Content="2DF" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="2df"/>
                            <Button Content="GGBases" Padding="16,6" Margin="4"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="ggbases"/>
                        </WrapPanel>

                        <TextBlock Text="攻略検索" Foreground="#CCC" FontSize="14" FontWeight="Bold" Margin="0,16,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Game.MainTitle, Mode=OneWay}" IsReadOnly="True"
                                     Width="400" Padding="6,4" FontSize="13"/>
                            <Button Content="Search" Padding="16,6" Margin="8,0"
                                    Command="{Binding OpenExternalSearchCommand}" CommandParameter="google"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- ========== 编辑标题 Modal ========== -->
            <Border Background="#80000000" Visibility="{Binding IsEditModalVisible, Converter={StaticResource Bool2Vis}}">
                <Border Background="#2A2A3C" CornerRadius="8" Padding="24" Width="500"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Edit Title" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Game.Name}" Foreground="#999" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Button Content="Split" Command="{Binding SplitTitleCommand}" Padding="12,4"
                                HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="Main" Foreground="#999" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Game.MainTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock Text="Sub" Foreground="#999" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Game.SubTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" FontSize="14" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Click="CancelEdit_Click"/>
                            <Button Content="Update" Padding="16,6"
                                    Command="{Binding UpdateTitleCommand}" Background="#4466AA" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
