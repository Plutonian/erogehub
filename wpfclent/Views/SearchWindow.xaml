<Window x:Class="ErogeHub.Wpf.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:ErogeHub.Wpf.Converters"
        xmlns:vm="clr-namespace:ErogeHub.Wpf.ViewModels"
        xmlns:models="clr-namespace:ErogeHub.Wpf.Models"
        Title="ErogeHub" Width="1400" Height="900"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:PlayStateToBrushConverter x:Key="PlayStateBrush"/>
        <conv:EmotionToBrushConverter x:Key="EmotionBrush"/>
        <conv:IsStarInputConverter x:Key="IsStar"/>
        <conv:IsSelectInputConverter x:Key="IsSelect"/>
        <conv:IsTextInputConverter x:Key="IsText"/>
        <conv:StringToVisibilityConverter x:Key="Str2Vis"/>
        <conv:WebsiteToVisibilityConverter x:Key="Web2Vis"/>
        <conv:StringDoubleConverter x:Key="Str2Double"/>
        <conv:EmptyToVisibilityConverter x:Key="Empty2Vis"/>
        <conv:DateRelativeConverter x:Key="DateRel"/>

        <!-- ========== 游戏卡片模板（282px 宽，全交互） ========== -->
        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type models:Game}">
            <Border Width="282" Margin="4" Background="#2A2A3C" CornerRadius="6"
                    BorderBrush="{Binding Emotion, Converter={StaticResource EmotionBrush}}"
                    BorderThickness="2">
                <StackPanel>
                    <!-- 封面图（点击打开详情）— Height 设在 Button 上 -->
                    <Button Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               CommandParameter="{Binding}"
                               Padding="0" BorderThickness="0" Background="Transparent"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand"
                               Height="396">
                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                    </Button>

                    <StackPanel Margin="6,4">
                        <!-- 标题行: PlayState 圆圈 + MainTitle + [Delete] -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding DataContext.CycleCardPlayStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                       ToolTip="PlayState (click to cycle)">
                                <Ellipse Width="16" Height="16" Fill="{Binding PlayState, Converter={StaticResource PlayStateBrush}}"/>
                            </Button>
                            <TextBlock Text="{Binding MainTitle}" FontWeight="Bold" Foreground="#E0E0E0" FontSize="14"
                                       TextTrimming="CharacterEllipsis" Margin="4,0,0,0" MaxWidth="210"/>
                            <Button Content="[Del]" Foreground="#FF4444" FontSize="10" Margin="4,0,0,0"
                                       Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                       Style="{StaticResource ButtonDanger}"
                                       Visibility="{Binding IsSame, Converter={StaticResource Bool2Vis}}"
                                       Command="{Binding DataContext.DeleteCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"/>
                        </StackPanel>

                        <!-- SubTitle -->
                        <TextBlock Text="{Binding SubTitle}" Foreground="#999" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Brand (可点击) + 公式サイト -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding Brand.Name, Converter={StaticResource Str2Vis}}">
                            <Button Command="{Binding DataContext.BrandClickToSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding Brand.Name}"
                                       Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
                                <TextBlock Text="{Binding Brand.Name}" Foreground="#7AB8FF" FontSize="12"/>
                            </Button>
                            <TextBlock Margin="4,0,0,0" FontSize="11"
                                       Visibility="{Binding Brand.Website, Converter={StaticResource Web2Vis}}">
                                <Hyperlink NavigateUri="{Binding Brand.Website}"
                                           RequestNavigate="OpenHyperlink_RequestNavigate">
                                    <Run Text="(公式サイト)" Foreground="#7AB8FF"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- Star + Emotion + Location + MarkSame -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <hc:Rate Value="{Binding Star, Mode=TwoWay}" AllowClear="True"
                                     FontSize="14" Foreground="#FFB800"
                                     Visibility="{Binding ShowStar, Converter={StaticResource Bool2Vis}}"
                                     ValueChanged="CardRate_ValueChanged"/>
                            <Button Command="{Binding DataContext.CycleCardEmotionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                       Visibility="{Binding ShowEmotion, Converter={StaticResource Bool2Vis}}"
                                       ToolTip="Emotion (click to cycle)" Margin="8,0,0,0">
                                <TextBlock Text="♥" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Emotion}" Value="-99">
                                                    <Setter Property="Foreground" Value="#8B0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Emotion}" Value="1">
                                                    <Setter Property="Foreground" Value="#FF69B4"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Emotion}" Value="99">
                                                    <Setter Property="Foreground" Value="#FF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding DataContext.ToggleCardLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                       Visibility="{Binding Published, Converter={StaticResource Bool2Vis}}"
                                       ToolTip="Location (click to toggle)" Margin="8,0,0,0">
                                <TextBlock FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓"/>
                                            <Setter Property="Foreground" Value="#44AA44"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Location}" Value="0">
                                                    <Setter Property="Text" Value="☁"/>
                                                    <Setter Property="Foreground" Value="#88AACC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <ToggleButton IsChecked="{Binding IsSame, Mode=TwoWay}" Click="CardMarkSame_Click" Content="同" Margin="8,0,0,0" Padding="6,2" FontSize="11" ToolTip="MarkSame"/>
                        </StackPanel>

                        <!-- Tags (点击添加搜索条件) -->
                        <ItemsControl ItemsSource="{Binding Tag}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="10" Margin="0,0,4,3"
                                               Padding="5,2" Background="#FFABD3" Foreground="#333"
                                               BorderThickness="0" Cursor="Hand"
                                               Command="{Binding DataContext.TagClickToSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 日期 -->
                        <TextBlock Text="{Binding PublishDate, Converter={StaticResource DateRel}}"
                                   Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ========== 搜索条件项模板 ========== -->
        <DataTemplate x:Key="SearchOptTemplate" DataType="{x:Type models:SearchOpt}">
            <Border Background="#33334A" CornerRadius="4" Margin="0,2" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <hc:ComboBox Grid.Column="0" MinWidth="100" Margin="0,0,4,0"
                                 ItemsSource="{x:Static vm:SearchViewModel.SearchTypeOptions}"
                                 DisplayMemberPath="Label" SelectedValuePath="Type"
                                 SelectedValue="{Binding Key}" IsEnabled="{Binding Enabled}"/>
                    <hc:TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding Enabled}"
                                Visibility="{Binding Key, Converter={StaticResource IsText}}"
                                VerticalContentAlignment="Center"/>
                    <hc:Rate Grid.Column="1" Value="{Binding Value, Converter={StaticResource Str2Double}, Mode=TwoWay}"
                             IsEnabled="{Binding Enabled}" AllowClear="True"
                             Visibility="{Binding Key, Converter={StaticResource IsStar}}"
                             VerticalAlignment="Center"/>
                    <hc:ComboBox Grid.Column="1" IsEnabled="{Binding Enabled}"
                                 Visibility="{Binding Key, Converter={StaticResource IsSelect}}"
                                 SelectedValue="{Binding Value}" VerticalContentAlignment="Center">
                        <hc:ComboBox.Style>
                            <Style TargetType="hc:ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Key}" Value="{x:Static models:SearchType.EMOTION}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:SearchViewModel.EmotionOptions}"/>
                                        <Setter Property="DisplayMemberPath" Value="Label"/>
                                        <Setter Property="SelectedValuePath" Value="Value"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="{x:Static models:SearchType.LOCATION}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:SearchViewModel.LocationOptions}"/>
                                        <Setter Property="DisplayMemberPath" Value="Label"/>
                                        <Setter Property="SelectedValuePath" Value="Value"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="{x:Static models:SearchType.PLAYSTATE}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:SearchViewModel.PlayStateOptions}"/>
                                        <Setter Property="DisplayMemberPath" Value="Label"/>
                                        <Setter Property="SelectedValuePath" Value="Value"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:ComboBox.Style>
                    </hc:ComboBox>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Margin="4,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="&#x21C4;" ToolTip="交换" Margin="2,0" Padding="6,2"
                                   Command="{Binding DataContext.SwapSearchOptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}"/>
                        <Button Content="&#xD7;" ToolTip="删除" Margin="2,0" Padding="6,2"
                                   Style="{StaticResource ButtonDanger}"
                                   Command="{Binding DataContext.RemoveSearchOptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ========== 通用聚合项模板 ========== -->
        <DataTemplate x:Key="GroupItemTemplate" DataType="{x:Type models:GroupItem}">
            <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                       Command="{Binding DataContext.OnTagClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                        <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="StarGroupTemplate" DataType="{x:Type models:StarGroupItem}">
            <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                       Command="{Binding DataContext.OnStarClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#CCC" Margin="8,0,0,0"/>
                    <hc:Rate Value="{Binding Star}" IsReadOnly="True" AllowClear="False" FontSize="12" Foreground="#FFB800"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="DateGroupTemplate" DataType="{x:Type models:DateGroupItem}"
                                  ItemsSource="{Binding Children}">
            <Button Padding="2,1" HorizontalContentAlignment="Stretch"
                       Command="{Binding DataContext.OnDateClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#888" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                </DockPanel>
            </Button>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="BrandGroupTemplate" DataType="{x:Type models:BrandGroupItem}"
                                  ItemsSource="{Binding Children}">
            <Button Padding="2,1" HorizontalContentAlignment="Stretch"
                       Command="{Binding DataContext.OnBrandClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#888" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                </DockPanel>
            </Button>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧：搜索面板 ========== -->
        <Border Grid.Column="0" Background="#252535" Margin="4" CornerRadius="6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Button DockPanel.Dock="Right" Content="Search" Padding="12,4"
                               Style="{StaticResource ButtonPrimary}"
                               Command="{Binding SearchCommand}"/>
                    <TextBlock Text="Search" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <!-- ========== 日期范围（紧凑2行） ========== -->
                        <!-- 第1行: 标签 + 下拉预设 + E启用开关 -->
                        <DockPanel Margin="0,10,0,4">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsDateRangeEnabled}"
                                      Content="E" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ToolTip="启用/禁用日期筛选"/>
                            <hc:ComboBox ItemsSource="{Binding DatePresets}" DisplayMemberPath="Label"
                                         SelectedValuePath="Key" SelectedValue="{Binding SelectedDatePreset}"
                                         IsEnabled="{Binding IsDateRangeEnabled}" Margin="8,0,0,0"
                                         MinWidth="100" VerticalContentAlignment="Center"/>
                            <TextBlock Text="发布日期" Foreground="#AAA" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- 第2行: 日期输入框 + 快捷按钮（同一行） -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 起始月份 (仅自定义预设时显示) -->
                            <hc:TextBox Grid.Column="0" Text="{Binding CurrentDateRange.StartMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" IsEnabled="{Binding IsDateRangeEnabled}" hc:InfoElement.Placeholder="yyyy-MM"
                                        VerticalContentAlignment="Center"
                                        Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 分隔符 (仅自定义预设时显示) -->
                            <TextBlock Grid.Column="1" Text="~" Foreground="#777" Margin="6,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 结束月份 (仅自定义预设时显示) -->
                            <hc:TextBox Grid.Column="2" Text="{Binding CurrentDateRange.EndMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" IsEnabled="{Binding IsDateRangeEnabled}" hc:InfoElement.Placeholder="yyyy-MM"
                                        VerticalContentAlignment="Center"
                                        Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 快捷按钮组 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsDateRangeEnabled}">
                                <Button Content="-年" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="-1y"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="-月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="-1m"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="这个月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="this_month"
                                        Background="#335577" Foreground="#FFF" BorderThickness="0" FontWeight="Bold"/>
                                <Button Content="+月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="+1m"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="+年" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="+1y"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,4,0,2">
                            <Button DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                       Style="{StaticResource ButtonPrimary}"
                                       Command="{Binding AddSearchOptCommand}" CommandParameter="Include"/>
                            <TextBlock Text="包含" Foreground="#7AB8FF" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding IncludeOpts}" ItemTemplate="{StaticResource SearchOptTemplate}" Margin="0,2,0,4"/>

                        <DockPanel Margin="0,4,0,2">
                            <Button DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                       Style="{StaticResource ButtonDanger}"
                                       Command="{Binding AddSearchOptCommand}" CommandParameter="Exclude"/>
                            <TextBlock Text="排除" Foreground="#FF8866" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ExcludeOpts}" ItemTemplate="{StaticResource SearchOptTemplate}" Margin="0,2,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== 中间：游戏列表 ========== -->
        <DockPanel Grid.Column="1" Margin="4">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="共 " Foreground="#999"/>
                    <Run Text="{Binding Total}" Foreground="#7AB8FF"/>
                    <Run Text=" 条" Foreground="#999"/>
                </TextBlock>
                <hc:Pagination MaxPageCount="{Binding TotalPages}" PageIndex="{Binding Page}"
                               PageUpdated="Pagination_PageUpdated"/>
            </StackPanel>

            <hc:SimplePanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <hc:LoadingCircle Visibility="{Binding IsLoading, Converter={StaticResource Bool2Vis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </hc:SimplePanel>
        </DockPanel>

        <!-- ========== 右侧：聚合面板 ========== -->
        <Border Grid.Column="2" Background="#252535" Margin="4" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <Expander Header="日期" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <TreeView ItemsSource="{Binding DateGroup}" ItemTemplate="{StaticResource DateGroupTemplate}"
                                     Background="Transparent" Margin="4"/>
                    </Expander>
                    <Expander Header="星级" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding StarGroup}" ItemTemplate="{StaticResource StarGroupTemplate}" Margin="4"/>
                    </Expander>
                    <Expander Header="情感" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding EmotionGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:EmotionGroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OnEmotionClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="位置" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding LocationGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LocationGroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OnLocationClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="游玩状态" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding PlayStateGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PlayStateGroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OnPlayStateClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="声优" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding CVGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OnCVClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="去马甲CV" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding TrueCVGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OnTrueCVClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="Tag" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <ItemsControl ItemsSource="{Binding TagGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OnTagClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Header="品牌" IsExpanded="False" Foreground="#CCC" Margin="0,2">
                        <TreeView ItemsSource="{Binding BrandGroup}" ItemTemplate="{StaticResource BrandGroupTemplate}"
                                     Background="Transparent" Margin="4"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
