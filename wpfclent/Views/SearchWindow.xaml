<!--
    SearchWindow - ErogeHub 游戏搜索主窗口
    布局：左侧搜索面板 | 中间游戏卡片列表 | 右侧聚合分析面板
-->
<Window x:Class="ErogeHub.Wpf.Views.SearchWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:ErogeHub.Wpf.ViewModels"
        xmlns:models="clr-namespace:ErogeHub.Wpf.Models"
        xmlns:controls="clr-namespace:ErogeHub.Wpf.Controls"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="ErogeHub" Width="1400" Height="900"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">

    <!-- ========== 窗口资源：合并全局 Converters/Controls + 本窗口专用 DataTemplates ========== -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ========== 三栏主布局：左(搜索) | 中(列表) | 右(聚合) ========== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧栏：搜索面板（360px 固定宽度） ========== -->
        <Border Grid.Column="0" Background="#252535" Margin="4" CornerRadius="6">
            <DockPanel>
                <!-- 搜索面板标题栏：标题 + Clone + Search 按钮 -->
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Button DockPanel.Dock="Right" Content="Search" Padding="12,4"
                               Style="{StaticResource ButtonPrimary}"
                               Command="{Binding SearchCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Clone" Padding="8,4" Margin="0,0,4,0"
                               Background="#444466" Foreground="#CCC" BorderThickness="0"
                               Command="{Binding CloneSearchCommand}"/>
                    <TextBlock Text="Search" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <!-- ========== 日期范围筛选（紧凑2行布局） ========== -->
                        <!-- 第1行：标签 + 下拉预设 + 启用开关 -->
                        <DockPanel Margin="0,10,0,4">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsDateRangeEnabled}"
                                      Content="E" Margin="5,0,0,0" VerticalAlignment="Center"
                                      ToolTip="启用/禁用日期筛选"/>
                            <TextBlock Text="发布日期" Foreground="#AAA" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <hc:ComboBox ItemsSource="{Binding DatePresets}" DisplayMemberPath="Label"
                                         SelectedValuePath="Key" SelectedValue="{Binding SelectedDatePreset}"
                                         IsEnabled="{Binding IsDateRangeEnabled}"
                                         MinWidth="100" VerticalContentAlignment="Center" DockPanel.Dock="Left" Width="216"/>
                        </DockPanel>

                        <!-- 第2行：自定义日期输入框 + 快捷调整按钮 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 起始月份输入框（仅自定义预设时显示） -->
                            <hc:TextBox Grid.Column="0" Text="{Binding CurrentDateRange.StartMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" IsEnabled="{Binding IsDateRangeEnabled}" hc:InfoElement.Placeholder="yyyy-MM"
                                        VerticalContentAlignment="Center"
                                        Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 日期范围分隔符 -->
                            <TextBlock Grid.Column="1" Text="~" Foreground="#777" Margin="6,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 结束月份输入框（仅自定义预设时显示） -->
                            <hc:TextBox Grid.Column="2" Text="{Binding CurrentDateRange.EndMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" IsEnabled="{Binding IsDateRangeEnabled}" hc:InfoElement.Placeholder="yyyy-MM"
                                        VerticalContentAlignment="Center"
                                        Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 快捷按钮组：-年/-月/这个月/+月/+年 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsDateRangeEnabled}">
                                <Button Content="-年" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="-1y"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="-月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="-1m"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="这个月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="this_month"
                                        Background="#335577" Foreground="#FFF" BorderThickness="0" FontWeight="Bold"/>
                                <Button Content="+月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="+1m"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="+年" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="+1y"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 包含条件列表：匹配这些条件的游戏才会显示 -->
                        <DockPanel Margin="0,4,0,2">
                            <Button DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                       Style="{StaticResource ButtonPrimary}"
                                       Command="{Binding AddSearchOptCommand}" CommandParameter="Include"/>
                            <TextBlock Text="包含" Foreground="#7AB8FF" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding IncludeOpts}" ItemTemplate="{StaticResource SearchOptTemplate}" Margin="0,2,0,4"/>

                        <!-- 排除条件列表：匹配这些条件的游戏会被过滤掉 -->
                        <DockPanel Margin="0,4,0,2">
                            <Button DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                       Style="{StaticResource ButtonDanger}"
                                       Command="{Binding AddSearchOptCommand}" CommandParameter="Exclude"/>
                            <TextBlock Text="排除" Foreground="#FF8866" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ExcludeOpts}" ItemTemplate="{StaticResource SearchOptTemplate}" Margin="0,2,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== 中间栏：游戏卡片列表（自适应宽度） ========== -->
        <DockPanel Grid.Column="1" Margin="4">
            <!-- 底部状态栏：分页在左，分组在右 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,4" LastChildFill="False"
                        Visibility="{Binding HasSearched, Converter={StaticResource Bool2Vis}}">

                <!-- 分页信息 + 控件（左侧） -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            >
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="共 " Foreground="#999"/>
                        <Run Text="{Binding Total}" Foreground="#7AB8FF"/>
                        <Run Text=" 条" Foreground="#999"/>
                    </TextBlock>
                    <hc:Pagination MaxPageCount="{Binding TotalPages}" PageIndex="{Binding Page, Mode=TwoWay}"
                                   PageUpdated="Pagination_PageUpdated" Visibility="{Binding IsNotGrouping, Converter={StaticResource Bool2Vis}}"/>
                </StackPanel>

                <!-- 分组类型选择器（右侧） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="分组" Foreground="#999" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <hc:ComboBox ItemsSource="{x:Static vm:SearchViewModel.GroupTypeOptions}"
                                 DisplayMemberPath="Label" SelectedValuePath="Type"
                                 SelectedValue="{Binding SelectedGroupType}"
                                 MinWidth="80" VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- 卡片列表：平铺 / 分组双视图，加载时显示 LoadingCircle -->
            <hc:SimplePanel>
                <!-- 平铺模式（无分组） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsNotGrouping, Converter={StaticResource Bool2Vis}}">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 分组模式：虚拟化 ListBox + CollectionView 分组（外层虚拟化组、内层虚拟化卡片） -->
                <ListBox ItemsSource="{Binding Games}"
                         ItemTemplate="{StaticResource GameCardTemplate}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsGrouping, Converter={StaticResource Bool2Vis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander Background="#2D2D42" Foreground="#DDD"
                                                          BorderBrush="#555" BorderThickness="0,0,0,1"
                                                          Margin="0,2" Padding="8,5" IsExpanded="True">
                                                    <Expander.Header>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Background="#444466"
                                                                    CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding ItemCount}"
                                                                           Foreground="#CCC" FontSize="10"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" Foreground="#DDD"
                                                                       FontWeight="SemiBold"/>
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="4"/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <hc:LoadingCircle Visibility="{Binding IsLoading, Converter={StaticResource Bool2Vis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </hc:SimplePanel>
        </DockPanel>

        <!-- ========== 右侧栏：聚合分析面板（310px 固定宽度） ========== -->
        <Border Grid.Column="2" Background="#252535" Margin="4" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4">
                    <!-- 日期分布（树形结构：年 → 月） -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleDate" Style="{StaticResource AggToggleStyle}" Content="日期" IsChecked="True"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleDate, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding DateGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DateGroupItem}">
                                    <controls:YearCalendarControl Year="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 星级分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleStar" Style="{StaticResource AggToggleStyle}" Content="星级"/>
                        <ListBox Grid.Row="1"
                                 Visibility="{Binding IsChecked, ElementName=ToggleStar, Converter={StaticResource Bool2Vis}}"
                                 ItemsSource="{Binding StarGroup}" ItemTemplate="{StaticResource StarGroupTemplate}"
                                 ItemContainerStyle="{StaticResource AggListBoxItemStyle}"
                                 SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="4"
                                 SelectionChanged="StarListBox_SelectionChanged"/>
                    </Grid>

                    <!-- 情感分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleEmotion" Style="{StaticResource AggToggleStyle}" Content="情感"/>
                        <ListBox Grid.Row="1"
                                 Visibility="{Binding IsChecked, ElementName=ToggleEmotion, Converter={StaticResource Bool2Vis}}"
                                 ItemsSource="{Binding EmotionGroup}" Margin="4"
                                 ItemContainerStyle="{StaticResource AggListBoxItemStyle}"
                                 SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="EmotionListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:EmotionGroupItem}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#CCC" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 存储位置分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleLocation" Style="{StaticResource AggToggleStyle}" Content="位置"/>
                        <ListBox Grid.Row="1"
                                 Visibility="{Binding IsChecked, ElementName=ToggleLocation, Converter={StaticResource Bool2Vis}}"
                                 ItemsSource="{Binding LocationGroup}" Margin="4"
                                 ItemContainerStyle="{StaticResource AggListBoxItemStyle}"
                                 SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="LocationListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LocationGroupItem}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#CCC" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 游玩状态分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="TogglePlayState" Style="{StaticResource AggToggleStyle}" Content="游玩状态"/>
                        <ListBox Grid.Row="1"
                                 Visibility="{Binding IsChecked, ElementName=TogglePlayState, Converter={StaticResource Bool2Vis}}"
                                 ItemsSource="{Binding PlayStateGroup}" Margin="4"
                                 ItemContainerStyle="{StaticResource AggListBoxItemStyle}"
                                 SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="PlayStateListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PlayStateGroupItem}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#CCC" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 品牌分布（树形结构） -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleBrand" Style="{StaticResource AggToggleStyle}" Content="品牌"/>
                        <TreeView Grid.Row="1"
                                  Visibility="{Binding IsChecked, ElementName=ToggleBrand, Converter={StaticResource Bool2Vis}}"
                                  ItemsSource="{Binding BrandGroup}" ItemTemplate="{StaticResource BrandGroupTemplate}"
                                  Background="Transparent" Margin="4"
                                  SelectedItemChanged="BrandTree_SelectedItemChanged"/>
                    </Grid>

                    <!-- Tag 标签分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleTag" Style="{StaticResource AggToggleStyle}" Content="Tag"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleTag, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding TagGroup}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,0,4,3" Padding="5,2"
                                            Background="#FFABD3" Foreground="#333"
                                            BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.TagClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            <TextBlock Text="{Binding Count}" Foreground="#555" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 声优分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleCV" Style="{StaticResource AggToggleStyle}" Content="声优"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleCV, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding CvGroup}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,0,4,3" Padding="5,2"
                                            Background="#3D3D52" Foreground="#DDD"
                                            BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.CVClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            <TextBlock Text="{Binding Count}" Foreground="#999" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 去马甲CV分布（合并了马甲的声优真实姓名统计） -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleTrueCV" Style="{StaticResource AggToggleStyle}" Content="去马甲CV"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleTrueCV, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding TrueCVGroup}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,0,4,3" Padding="5,2"
                                            Background="#3D3D52" Foreground="#DDD"
                                            BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.TrueCVClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            <TextBlock Text="{Binding Count}" Foreground="#999" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>




                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
