<!--
    SearchWindow - ErogeHub 游戏搜索主窗口
    布局：左侧搜索面板 | 中间游戏卡片列表 | 右侧聚合分析面板
-->
<Window x:Class="ErogeHub.Wpf.Views.SearchWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:ErogeHub.Wpf.Converters"
        xmlns:vm="clr-namespace:ErogeHub.Wpf.ViewModels"
        xmlns:models="clr-namespace:ErogeHub.Wpf.Models"
        xmlns:controls="clr-namespace:ErogeHub.Wpf.Controls"
        Title="ErogeHub" Width="1400" Height="900"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">

    <!-- ========== 窗口资源：转换器 & 模板 & 样式 ========== -->
    <Window.Resources>
        <!-- 通用值转换器 -->
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:PlayStateToBrushConverter x:Key="PlayStateBrush"/>
        <conv:EmotionToBrushConverter x:Key="EmotionBrush"/>
        <conv:IsStarInputConverter x:Key="IsStar"/>
        <conv:IsSelectInputConverter x:Key="IsSelect"/>
        <conv:IsTextInputConverter x:Key="IsText"/>
        <conv:StringToVisibilityConverter x:Key="Str2Vis"/>
        <conv:WebsiteToVisibilityConverter x:Key="Web2Vis"/>
        <conv:StringDoubleConverter x:Key="Str2Double"/>
        <conv:EmptyToVisibilityConverter x:Key="Empty2Vis"/>
        <conv:DateRelativeConverter x:Key="DateRel"/>

        <!-- ========== 游戏卡片模板（使用 GameCardControl 用户控件） ========== -->
        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type models:Game}">
            <controls:GameCardControl
                Game="{Binding}"
                OpenDetailCommand="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CycleCardEmotionCommand="{Binding DataContext.CycleCardEmotionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CycleCardPlayStateCommand="{Binding DataContext.CycleCardPlayStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                DeleteCardCommand="{Binding DataContext.DeleteCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                BrandClickToSearchCommand="{Binding DataContext.BrandClickToSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                ToggleCardLocationCommand="{Binding DataContext.ToggleCardLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                TagClickToSearchCommand="{Binding DataContext.TagClickToSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                StarChangedCommand="{Binding DataContext.CardStarChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>

        <!-- ========== 搜索条件项模板（左侧搜索面板中的每一条搜索条件） ========== -->
        <DataTemplate x:Key="SearchOptTemplate" DataType="{x:Type models:SearchOpt}">
            <Border Background="#33334A" CornerRadius="4" Margin="0,2" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 搜索类型下拉框：TITLE/EMOTION/LOCATION/PLAYSTATE/TAG 等 -->
                    <hc:ComboBox Grid.Column="0" MinWidth="100" Margin="0,0,4,0"
                                 ItemsSource="{x:Static vm:SearchViewModel.SearchTypeOptions}"
                                 DisplayMemberPath="Label" SelectedValuePath="Type"
                                 SelectedValue="{Binding Key}" IsEnabled="{Binding Enabled}"/>
                    <!-- 纯文本输入：当搜索类型为文本型时显示 -->
                    <hc:TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding Enabled}"
                                Visibility="{Binding Key, Converter={StaticResource IsText}}"
                                VerticalContentAlignment="Center"/>
                    <!-- 星级评分输入：当搜索类型为 STAR 时显示 -->
                    <hc:Rate Grid.Column="1" Value="{Binding Value, Converter={StaticResource Str2Double}, Mode=TwoWay}"
                             IsEnabled="{Binding Enabled}" AllowClear="True"
                             Visibility="{Binding Key, Converter={StaticResource IsStar}}"
                             VerticalAlignment="Center"/>
                    <!-- 下拉选择输入：当搜索类型为 EMOTION/LOCATION/PLAYSTATE 时显示对应选项 -->
                    <hc:ComboBox Grid.Column="1" IsEnabled="{Binding Enabled}"
                                 Visibility="{Binding Key, Converter={StaticResource IsSelect}}"
                                 SelectedValue="{Binding Value}" VerticalContentAlignment="Center">
                        <hc:ComboBox.Style>
                            <Style TargetType="hc:ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Key}" Value="{x:Static models:SearchType.EMOTION}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:SearchViewModel.EmotionOptions}"/>
                                        <Setter Property="DisplayMemberPath" Value="Label"/>
                                        <Setter Property="SelectedValuePath" Value="Value"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="{x:Static models:SearchType.LOCATION}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:SearchViewModel.LocationOptions}"/>
                                        <Setter Property="DisplayMemberPath" Value="Label"/>
                                        <Setter Property="SelectedValuePath" Value="Value"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="{x:Static models:SearchType.PLAYSTATE}">
                                        <Setter Property="ItemsSource" Value="{x:Static vm:SearchViewModel.PlayStateOptions}"/>
                                        <Setter Property="DisplayMemberPath" Value="Label"/>
                                        <Setter Property="SelectedValuePath" Value="Value"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:ComboBox.Style>
                    </hc:ComboBox>
                    <!-- 启用/禁用该搜索条件的复选框 -->
                    <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Margin="4,0" VerticalAlignment="Center"/>
                    <!-- 操作按钮：交换（将包含条件变为排除条件，反之亦然）、删除 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="&#x21C4;" ToolTip="交换" Margin="2,0" Padding="6,2"
                                   Command="{Binding DataContext.SwapSearchOptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}"/>
                        <Button Content="&#xD7;" ToolTip="删除" Margin="2,0" Padding="6,2"
                                   Style="{StaticResource ButtonDanger}"
                                   Command="{Binding DataContext.RemoveSearchOptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ========== 通用聚合项模板：名称 + 数量，用于 Tag/CV 等 ========== -->
        <DataTemplate x:Key="GroupItemTemplate" DataType="{x:Type models:GroupItem}">
            <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                       Command="{Binding DataContext.TagClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                        <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- 星级聚合项模板：星级评分 + 数量 -->
        <DataTemplate x:Key="StarGroupTemplate" DataType="{x:Type models:StarGroupItem}">
            <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                       Command="{Binding DataContext.StarClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#CCC" Margin="8,0,0,0"/>
                    <hc:Rate Value="{Binding Star}" IsReadOnly="True" AllowClear="False" FontSize="12" Foreground="#FFB800" IsHitTestVisible="False"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- 日期聚合项模板：支持层级展开（年 → 月），使用 HierarchicalDataTemplate -->
        <HierarchicalDataTemplate x:Key="DateGroupTemplate" DataType="{x:Type models:DateGroupItem}"
                                  ItemsSource="{Binding Children}">
            <Button Padding="2,1" HorizontalContentAlignment="Stretch" Background="Transparent"
                       Command="{Binding DataContext.DateClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#888" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                </DockPanel>
            </Button>
        </HierarchicalDataTemplate>

        <!-- 品牌聚合项模板：支持层级展开，使用 HierarchicalDataTemplate -->
        <HierarchicalDataTemplate x:Key="BrandGroupTemplate" DataType="{x:Type models:BrandGroupItem}"
                                  ItemsSource="{Binding Children}">
            <Button Padding="2,1" HorizontalContentAlignment="Stretch" Background="Transparent"
                       Command="{Binding DataContext.BrandClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#888" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                </DockPanel>
            </Button>
        </HierarchicalDataTemplate>

        <!-- ========== 右侧聚合面板折叠/展开按钮样式 ========== -->
        <Style x:Key="AggToggleStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Background" Value="#2D2D42"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <TextBlock x:Name="arrow" DockPanel.Dock="Left" Text="▶" FontSize="10"
                                           Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383852"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33334D"/>
                                <Setter TargetName="arrow" Property="Text" Value="▼"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ========== 三栏主布局：左(搜索) | 中(列表) | 右(聚合) ========== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧栏：搜索面板（360px 固定宽度） ========== -->
        <Border Grid.Column="0" Background="#252535" Margin="4" CornerRadius="6">
            <DockPanel>
                <!-- 搜索面板标题栏：标题 + Clone + Search 按钮 -->
                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Button DockPanel.Dock="Right" Content="Search" Padding="12,4"
                               Style="{StaticResource ButtonPrimary}"
                               Command="{Binding SearchCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Clone" Padding="8,4" Margin="0,0,4,0"
                               Background="#444466" Foreground="#CCC" BorderThickness="0"
                               Command="{Binding CloneSearchCommand}"/>
                    <TextBlock Text="Search" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <!-- ========== 日期范围筛选（紧凑2行布局） ========== -->
                        <!-- 第1行：标签 + 下拉预设 + 启用开关 -->
                        <DockPanel Margin="0,10,0,4">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsDateRangeEnabled}"
                                      Content="E" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ToolTip="启用/禁用日期筛选"/>
                            <TextBlock Text="发布日期" Foreground="#AAA" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <hc:ComboBox ItemsSource="{Binding DatePresets}" DisplayMemberPath="Label"
                                         SelectedValuePath="Key" SelectedValue="{Binding SelectedDatePreset}"
                                         IsEnabled="{Binding IsDateRangeEnabled}"
                                         MinWidth="100" VerticalContentAlignment="Center" DockPanel.Dock="Left" Width="216"/>
                        </DockPanel>

                        <!-- 第2行：自定义日期输入框 + 快捷调整按钮 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 起始月份输入框（仅自定义预设时显示） -->
                            <hc:TextBox Grid.Column="0" Text="{Binding CurrentDateRange.StartMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" IsEnabled="{Binding IsDateRangeEnabled}" hc:InfoElement.Placeholder="yyyy-MM"
                                        VerticalContentAlignment="Center"
                                        Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 日期范围分隔符 -->
                            <TextBlock Grid.Column="1" Text="~" Foreground="#777" Margin="6,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 结束月份输入框（仅自定义预设时显示） -->
                            <hc:TextBox Grid.Column="2" Text="{Binding CurrentDateRange.EndMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" IsEnabled="{Binding IsDateRangeEnabled}" hc:InfoElement.Placeholder="yyyy-MM"
                                        VerticalContentAlignment="Center"
                                        Visibility="{Binding IsCustomDatePreset, Converter={StaticResource Bool2Vis}}"/>

                            <!-- 快捷按钮组：-年/-月/这个月/+月/+年 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsDateRangeEnabled}">
                                <Button Content="-年" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="-1y"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="-月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="-1m"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="这个月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="this_month"
                                        Background="#335577" Foreground="#FFF" BorderThickness="0" FontWeight="Bold"/>
                                <Button Content="+月" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="+1m"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                                <Button Content="+年" Padding="4,0" FontSize="11" Margin="2,0"
                                        Command="{Binding AdjustDateRangeCommand}" CommandParameter="+1y"
                                        Background="#33334A" Foreground="#CCC" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 包含条件列表：匹配这些条件的游戏才会显示 -->
                        <DockPanel Margin="0,4,0,2">
                            <Button DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                       Style="{StaticResource ButtonPrimary}"
                                       Command="{Binding AddSearchOptCommand}" CommandParameter="Include"/>
                            <TextBlock Text="包含" Foreground="#7AB8FF" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding IncludeOpts}" ItemTemplate="{StaticResource SearchOptTemplate}" Margin="0,2,0,4"/>

                        <!-- 排除条件列表：匹配这些条件的游戏会被过滤掉 -->
                        <DockPanel Margin="0,4,0,2">
                            <Button DockPanel.Dock="Right" Content="+" Padding="8,2" Margin="4,0,0,0"
                                       Style="{StaticResource ButtonDanger}"
                                       Command="{Binding AddSearchOptCommand}" CommandParameter="Exclude"/>
                            <TextBlock Text="排除" Foreground="#FF8866" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ExcludeOpts}" ItemTemplate="{StaticResource SearchOptTemplate}" Margin="0,2,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== 中间栏：游戏卡片列表（自适应宽度） ========== -->
        <DockPanel Grid.Column="1" Margin="4">
            <!-- 底部分页栏：总数 + Pagination 控件 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="共 " Foreground="#999"/>
                    <Run Text="{Binding Total}" Foreground="#7AB8FF"/>
                    <Run Text=" 条" Foreground="#999"/>
                </TextBlock>
                <hc:Pagination MaxPageCount="{Binding TotalPages}" PageIndex="{Binding Page}"
                               PageUpdated="Pagination_PageUpdated"/>
            </StackPanel>

            <!-- 卡片列表：使用 WrapPanel 自动换行，加载时显示 LoadingCircle -->
            <hc:SimplePanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <hc:LoadingCircle Visibility="{Binding IsLoading, Converter={StaticResource Bool2Vis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </hc:SimplePanel>
        </DockPanel>

        <!-- ========== 右侧栏：聚合分析面板（310px 固定宽度） ========== -->
        <Border Grid.Column="2" Background="#252535" Margin="4" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <!-- 日期分布（树形结构：年 → 月） -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleDate" Style="{StaticResource AggToggleStyle}" Content="日期"/>
                        <TreeView Grid.Row="1"
                                  Visibility="{Binding IsChecked, ElementName=ToggleDate, Converter={StaticResource Bool2Vis}}"
                                  ItemsSource="{Binding DateGroup}" ItemTemplate="{StaticResource DateGroupTemplate}"
                                  Background="Transparent" Margin="4"/>
                    </Grid>

                    <!-- 星级分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleStar" Style="{StaticResource AggToggleStyle}" Content="星级"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleStar, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding StarGroup}" ItemTemplate="{StaticResource StarGroupTemplate}" Margin="4"/>
                    </Grid>

                    <!-- 情感分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleEmotion" Style="{StaticResource AggToggleStyle}" Content="情感"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleEmotion, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding EmotionGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:EmotionGroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                                               Command="{Binding DataContext.EmotionClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 存储位置分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleLocation" Style="{StaticResource AggToggleStyle}" Content="位置"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleLocation, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding LocationGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LocationGroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                                               Command="{Binding DataContext.LocationClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 游玩状态分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="TogglePlayState" Style="{StaticResource AggToggleStyle}" Content="游玩状态"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=TogglePlayState, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding PlayStateGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PlayStateGroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                                               Command="{Binding DataContext.PlayStateClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 声优分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleCV" Style="{StaticResource AggToggleStyle}" Content="声优"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleCV, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding CvGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                                               Command="{Binding DataContext.CVClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 去马甲CV分布（合并了马甲的声优真实姓名统计） -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleTrueCV" Style="{StaticResource AggToggleStyle}" Content="去马甲CV"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleTrueCV, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding TrueCVGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                                               Command="{Binding DataContext.TrueCVClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Tag 标签分布 -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleTag" Style="{StaticResource AggToggleStyle}" Content="Tag"/>
                        <ItemsControl Grid.Row="1"
                                      Visibility="{Binding IsChecked, ElementName=ToggleTag, Converter={StaticResource Bool2Vis}}"
                                      ItemsSource="{Binding TagGroup}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GroupItem}">
                                    <Button Margin="0,1" Padding="4,2" HorizontalContentAlignment="Stretch" Background="Transparent"
                                               Command="{Binding DataContext.TagClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#444466" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Count}" Foreground="#CCC" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#DDD" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 品牌分布（树形结构） -->
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0" x:Name="ToggleBrand" Style="{StaticResource AggToggleStyle}" Content="品牌"/>
                        <TreeView Grid.Row="1"
                                  Visibility="{Binding IsChecked, ElementName=ToggleBrand, Converter={StaticResource Bool2Vis}}"
                                  ItemsSource="{Binding BrandGroup}" ItemTemplate="{StaticResource BrandGroupTemplate}"
                                  Background="Transparent" Margin="4"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
